{
  "name": "devflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev -w @devflow/api\" \"npm run dev -w @devflow/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "@angular/build": {
      "undici": "7.30.1"
    }
  }
}
