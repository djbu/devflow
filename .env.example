# Copy to .env at the repository root. Never commit real secrets.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/devflow

# Required secrets. Generate each independently with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Use this exact origin (not localhost) so the OAuth state cookie survives the redirect.
APP_ORIGIN=http://127.0.0.1:4200
GITHUB_CALLBACK_URL=http://127.0.0.1:4200/api/auth/github/callback

# Configure both credentials or leave both blank (login is then unavailable).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# public_repo supports public repositories; repo also supports private repositories.
GITHUB_SCOPES=public_repo

# Milestone 4: public HTTPS origin forwarding to the webhook-only port.
WEBHOOK_PORT=3001
WEBHOOK_PUBLIC_URL=
# Generate another independent 32-byte random secret (at least 32 characters).
GITHUB_WEBHOOK_SECRET=
